# GravityLink 部署配置模板
# 使用方法：复制本文件为 .env 并填写实际值
#   cp .env.example .env
#
# MySQL / Redis 连接信息与认证方式（Logto / 本地账号）
# 不在此文件填写 —— 首次启动后通过管理端初始化向导完成。

# ===== 端口配置（可选，默认值如下）=====
# MySQL 对外暴露端口（本机已有 MySQL 时改为其他端口，如 13306）
MYSQL_PORT=13306
# Redis 对外暴露端口（本机已有 Redis 时改为其他端口，如 16379）
REDIS_PORT=16379
# 后端 API / 公网短链端口
APP_PORT=18080
# 管理端前端端口（首次初始化向导入口：http://127.0.0.1:18081）
ADMIN_PORT=18081

# ===== MySQL 密码（必填）=====
MYSQL_PASSWORD=change-me-strong-password

# ===== IP 归属地解析 =====
# 镜像已内置 ip2region IPv4 库（/app/ip2region.xdb），compose 默认 GEO_DB_PATH 指向该路径，
# 部署后开箱即用，无需再手动 docker cp。
# 如需使用自定义/更新的库：把 xdb 挂进数据卷，并把 GEO_DB_PATH 改回卷内路径，例如：
#   volumes:
#     - ./ip2region.xdb:/data/ip2region.xdb:ro
#   environment:
#     GEO_DB_PATH: /data/ip2region.xdb
# 文件缺失或加载失败时自动降级为不解析地域，不影响其他功能。
